<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

<h2> <%= name %>'s Wishlist</h2>
<p>(for Priority, 1 = most wanted, 5 = least wanted)</p>
<table class="table">
	<tr>
		<th>Name</th>
        <th>Image</th>
		<th>Link</th>
		<th>Description</th>
        <th>Priority </th>
		<th colspan="2"></th>
	</tr>

	<% if (wishlist && wishlist.length) { %>
		<% wishlist.forEach((item) => { %>
			<tr class="table-row">
				<td><%= item.name %></td>
				<% if(item.imageURL){ %>
   				<td><img class="image" src="<%= item.imageURL %>" alt="n/a" ></td>
 				<% } else{ %>  
   				<td><img class="image" src="/img/mystery.png" alt="n/a" ></td>
				<% } %>
                <td><a href="<%= item.link %>">link</a></td>
                <td><%= item.description %></td>
				<td><%= item.priority %></td>
			</tr>
		<% }) %>
	<% } %>
</table>

<%- include("partials/footer.ejs") %>