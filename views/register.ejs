<%- include("partials/head.ejs") %> <%- include("partials/header.ejs") %>
<form method="POST">
  
    <input type="hidden" name="_csrf" value="<%= _csrf %>" />
    <div class="form-grid">
      <label class="form-label" name="name">Enter your name:</label>
      <input class="form-input" name="name" />

      <label class="form-label" name="email">Enter your email:</label>
      <input class="form-input" name="email" />

      <label class="form-label" name="password">Enter your password:</label>
      <input class="form-input" type="password" name="password" />

      <label class="form-label" name="password1">Confirm your password:</label>
      <input class="form-input" type="password" name="password1" />
    </div>
    <div class="row">
      <button class="button-action">Register</button>
      <a href="/">
        <button class="button-cancel" type="button">Cancel</button>
      </a>
    </div>
  
</form>
<%- include("partials/footer.ejs") %>
